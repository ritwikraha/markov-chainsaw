{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0ad-bench.org/schemas/v0.1/task.schema.json",
  "title": "0AD-Bench task",
  "type": "object",
  "required": ["id", "version", "split", "category", "title", "description", "tracks", "scenario", "budget", "goal", "perturbations", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^(econ|tech|scout|combat|adapt)-[0-9]{3}$"},
    "version": {"const": "0.1"},
    "split": {"enum": ["development", "evaluation"]},
    "category": {"enum": ["economy", "building-tech", "scouting", "combat", "adaptive"]},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["symbolic", "vision", "hybrid"]}
    },
    "scenario": {
      "type": "object",
      "required": ["fixture", "map", "seed", "player_civ", "opponent"],
      "properties": {
        "fixture": {"type": "string"},
        "map": {"type": "string"},
        "seed": {"type": "integer"},
        "player_civ": {"type": "string"},
        "opponent": {
          "type": "object",
          "required": ["type", "difficulty"],
          "properties": {
            "type": {"type": "string"},
            "difficulty": {"type": "integer", "minimum": 0, "maximum": 5},
            "behavior": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": ["max_steps", "decision_interval", "max_agent_actions", "max_tokens", "max_mean_latency_ms"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "decision_interval": {"type": "integer", "minimum": 1},
        "max_agent_actions": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_mean_latency_ms": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["aggregation", "predicates"],
      "properties": {
        "aggregation": {"enum": ["all", "any", "fraction"]},
        "terminate_on_success": {"type": "boolean"},
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "op", "value"],
            "properties": {
              "path": {"type": "string"},
              "op": {"enum": ["eq", "ne", "gte", "lte", "gt", "lt", "contains"]},
              "value": {},
              "scope": {"enum": ["final", "any", "max", "min"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "perturbations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at_step", "type"],
        "properties": {
          "at_step": {"type": "integer", "minimum": 1},
          "type": {"enum": ["remove_units", "remove_resource", "spawn_attack", "change_enemy_composition", "destroy_structure", "block_route", "resource_shock"]},
          "parameters": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
